# BudgetFlow environment — copy to .env.local
# Leave MARIADB_* empty to run in dev/demo mode (in-memory store).
MARIADB_HOST=
MARIADB_PORT=3306
MARIADB_USER=
MARIADB_PASSWORD=
MARIADB_DATABASE=budgetflow

JWT_SECRET=change-me-to-a-long-random-string
DATA_ENC_KEY=change-me-32-bytes-hex-for-gemini-key-encryption
